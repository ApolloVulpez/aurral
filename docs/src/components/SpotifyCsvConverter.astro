<div class="spotify-converter">
  <label for="spotify-csv">Exportify CSV file</label>
  <input id="spotify-csv" type="file" accept=".csv,text/csv" />

  <div class="converter-actions">
    <button id="convert-csv" type="button" disabled>Convert CSV</button>
    <button id="download-json" type="button" disabled>Download JSON</button>
  </div>

  <p id="converter-status" class="converter-status" aria-live="polite">
    Choose an Exportify CSV file to begin.
  </p>
  <pre id="converter-preview" class="converter-preview" hidden></pre>
</div>

<script>
  import { convertSpotifyCsv } from "../scripts/spotifyCsvConverter.js";

  const input = document.querySelector("#spotify-csv");
  const convertButton = document.querySelector("#convert-csv");
  const downloadButton = document.querySelector("#download-json");
  const status = document.querySelector("#converter-status");
  const preview = document.querySelector("#converter-preview");
  let result;

  input?.addEventListener("change", () => {
    convertButton.disabled = !input.files?.length;
    downloadButton.disabled = true;
    preview.hidden = true;
    status.textContent = input.files?.[0]
      ? `Ready to convert ${input.files[0].name}.`
      : "Choose an Exportify CSV file to begin.";
  });

  convertButton?.addEventListener("click", async () => {
    const file = input.files?.[0];
    if (!file) return;

    try {
      result = convertSpotifyCsv(await file.text(), file.name);
      preview.textContent = JSON.stringify(result, null, 2);
      preview.hidden = false;
      downloadButton.disabled = false;
      status.textContent = `Converted ${result.tracks.length} tracks.`;
    } catch (error) {
      result = undefined;
      preview.hidden = true;
      downloadButton.disabled = true;
      status.textContent = error instanceof Error ? error.message : "Could not convert this CSV.";
    }
  });

  downloadButton?.addEventListener("click", () => {
    if (!result) return;
    const url = URL.createObjectURL(
      new Blob([JSON.stringify(result, null, 2)], { type: "application/json" }),
    );
    const link = document.createElement("a");
    link.href = url;
    link.download = `${result.name.replace(/\s+/g, "-").toLowerCase()}.json`;
    link.click();
    URL.revokeObjectURL(url);
  });
</script>

<style>
  .spotify-converter {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    margin-block: 1.5rem;
    padding: 1.25rem;
  }

  .spotify-converter label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .spotify-converter input {
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 4px;
    box-sizing: border-box;
    color: var(--sl-color-text);
    display: block;
    font: inherit;
    height: 2.75rem;
    padding: 0;
    width: min(100%, 28rem);
  }

  .spotify-converter input::file-selector-button {
    background: var(--sl-color-gray-6);
    border: 0;
    border-inline-end: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-white);
    cursor: pointer;
    font: inherit;
    height: 100%;
    margin-inline-end: 0.75rem;
    padding-inline: 0.875rem;
  }

  .converter-actions {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
    width: min(100%, 28rem);
  }

  .converter-actions button {
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 4px;
    box-sizing: border-box;
    color: var(--sl-color-text);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    height: 2.75rem;
    line-height: 1;
    margin: 0;
    padding-inline: 0.75rem;
  }

  .converter-actions button:hover:not(:disabled) {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }

  .converter-actions button:disabled {
    background: var(--sl-color-gray-7);
    color: var(--sl-color-gray-4);
    cursor: not-allowed;
  }

  .spotify-converter :is(input, button):focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }

  .converter-status {
    color: var(--sl-color-gray-2);
    margin-block: 1rem 0;
  }

  .converter-preview {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 4px;
    max-height: 22rem;
    overflow: auto;
    padding: 1rem;
  }
</style>
